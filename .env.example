# Personal data for the CV. Copy to .env and fill in:  cp .env.example .env
# input.cv.json refers to these as "${CV_EMAIL}". Quotes are optional.
# Required: the generator stops if one of these is empty.

# Output file name: pdfs/cv/<CV_FILE_NAME>-cv.pdf
CV_FILE_NAME="john-doe"
CV_FULL_NAME="John Doe"
CV_EMAIL="john.doe@example.com"
# City shown under your name and as the target location
CV_LOCATION="New York, NY, USA"

# Optional: leave empty to hide the line on the CV.
CV_PHONE="+1 555 010 0000"
# Street address, printed under the location
CV_ADDRESS=""
CV_LINKEDIN="https://linkedin.com/in/john-doe"
CV_GITHUB="https://github.com/johndoe"

# Folder with company and school logos; "logo" values in the profile are file names in it.
# Relative paths start from this project folder; ~ is expanded.
# Default: ./assets (only example-logo.png is committed).
CV_ASSETS_DIR="../pdfs/assets"
